{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/pulung/projects/mappingbot"
      ],
      "cwd": "/home/pulung/projects/mappingbot"
    },

    "ros2-workspace-inspector": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/pulung/tools/ros2-workspace-mcp",
        "run",
        "ros2-workspace-mcp",
        "--root",
        "/home/pulung/projects/mappingbot"
      ],
      "cwd": "/home/pulung/projects/mappingbot"
    },

    "ros-mcp-server": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "ros-mcp",
        "--with",
        "fastmcp>=2.11.3,<3",
        "ros-mcp",
        "--transport=stdio"
      ],
      "cwd": "/home/pulung/projects/mappingbot"
    }
  }
}